# ===========================================================================
# soundcheck runtime configuration
# ===========================================================================
# Copy this file to config/retention.env and edit. The real file is
# gitignored; only this example is committed: the same config/data split
# radio-kiosk uses with station.conf.
#
#   cp config/retention.env.example config/retention.env
#
# PRECEDENCE (weakest to strongest):
#   1. the defaults in lib/common.sh
#   2. this file
#   3. the environment  ->  RETENTION_COUNT=5 ./showtime.sh 1.2.0
#
# The environment winning over the file is what lets you try something once
# without editing config and remembering to change it back.
# ===========================================================================

# --- Retention -------------------------------------------------------------
# How many previous versions to keep images for.
#
# This is the answer to the question the original exercise could not handle:
# it kept exactly ONE previous image, so "the last two deploys were both bad"
# had no recovery path. Each version now keeps its own immutable tag and only
# the oldest are pruned.
#
# COUNT THIS CAREFULLY, because it is easy to be off by one. The number
# includes the version currently running. RETENTION_COUNT=3 keeps the live
# version plus the two before it, so the deepest rollback available is TWO
# steps back, not three.
#
# Choosing the number is a real tradeoff, not a formality:
#   too low   a rollback target you need has already been deleted
#   too high  disk fills up, and a full disk during an incident is a second,
#             worse incident on top of the one you were fixing
# 3 is the smallest value that survives "the last two deploys were both bad".
# It leaves no margin, so if deploys are frequent, raise it. The constraint is
# disk, and this app's image is about 130 MB.
RETENTION_COUNT=3

# --- Naming ----------------------------------------------------------------
APP_NAME=soundcheck-app             # the live container
CANDIDATE_NAME=soundcheck-candidate # the blue-green candidate
IMAGE_REPO=soundcheck-app           # local image repository (no registry)

# --- Ports -----------------------------------------------------------------
APP_PORT=8080        # where real traffic goes
CANDIDATE_PORT=8081  # where a new version proves itself before cutover

# --- Networking ------------------------------------------------------------
# A user-defined Docker network shared with the observability stack. It is
# what lets Prometheus scrape `soundcheck-app:8080` by name across deploys,
# even though the container behind that name is destroyed and recreated every
# time. showtime.sh creates it if it is missing.
DOCKER_NETWORK=soundcheck-net

# --- Health checking -------------------------------------------------------
HEALTH_PATH=/health
HEALTH_RETRIES=10    # attempts before declaring a deploy failed
HEALTH_INTERVAL=2    # seconds between attempts
# HEALTH_RETRIES * HEALTH_INTERVAL is your patience budget: 20s here. Raise it
# for an app with a slow start; lowering it makes deploys fail on cold caches.

# --- Logging ---------------------------------------------------------------
# text = colours and ticks for a human at a keyboard
# json = one JSON object per line on stdout, for a log collector
# Either way, structured events are ALWAYS appended to deploy_history.log.
# This only controls the terminal channel.
LOG_FORMAT=text

# The append-only event log. Promtail tails this file and ships it to Loki,
# which is what makes deploy history queryable by version and result instead
# of greppable on one machine.
# HISTORY_FILE=/absolute/path/to/deploy_history.log

# --- Success rate threshold (soundcheck.sh's standalone check) -------------
# The percentage below which soundcheck.sh reports a problem. Note this is
# checked against the app's LIFETIME average; the rate()-based version that
# actually reacts to a current outage is the Prometheus rule in
# observability/prometheus/alert_rules.yml.
SUCCESS_RATE_THRESHOLD=95.0

# --- Kubernetes mode -------------------------------------------------------
K8S_NAMESPACE=soundcheck
K8S_DEPLOYMENT=soundcheck
K8S_CONTEXT=kind-soundcheck
